# ELAP Production Configuration
# Copiar a .env y ajustar según necesidades

# Rust/Tauri
RUST_LOG=info
DATABASE_URL=postgresql://elap:elap@postgres:5432/elap
RUST_BACKTRACE=1

# Python
PYTHONUNBUFFERED=1
OLLAMA_URL=http://ollama:11434

# PostgreSQL
POSTGRES_USER=elap
POSTGRES_PASSWORD=elap
POSTGRES_DB=elap

# Services (en Docker, usar nombres de servicios)
# En local, cambiar a localhost:port
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
QDRANT_HOST=qdrant
QDRANT_PORT=6333
OLLAMA_HOST=ollama
OLLAMA_PORT=11434

# Deployment
ENVIRONMENT=production
LOG_LEVEL=info
