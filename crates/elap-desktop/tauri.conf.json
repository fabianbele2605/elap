{
  "productName": "ELAP",
  "version": "1.5.0",
  "identifier": "io.bblabs.elap",
  "build": {
    "beforeBuildCommand": "cd ../../web && npm run build",
    "beforeDevCommand": "",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ELAP - Enterprise Local AI Platform",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
