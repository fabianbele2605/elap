# ELAP Core - Rust Server
FROM rust:1.82 as builder

WORKDIR /app

# Copy Cargo files (sin Cargo.lock - lo generará Docker)
COPY Cargo.toml ./
COPY crates ./crates

# Build release
RUN cargo build --release -p elap-core

# Runtime stage
FROM debian:bookworm-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy binary from builder
COPY --from=builder /app/target/release/elap-core /app/elap-core

# Expose ports
EXPOSE 3000 50051

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

# Run
CMD ["/app/elap-core"]
