# ELAP AI Runtime - Python gRPC Server
FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# Copy Python app
COPY python ./python
WORKDIR /app/python

# Install dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Regenerate gRPC code (por si acaso)
RUN python -m grpc_tools.protoc \
    -I/app/python/src/elap_ai \
    --python_out=/app/python/src/elap_ai \
    --grpc_python_out=/app/python/src/elap_ai \
    /app/python/src/elap_ai/agent.proto 2>/dev/null || true

# Fix relative imports in generated files
RUN sed -i 's/^import agent_pb2/from . import agent_pb2/' /app/python/src/elap_ai/agent_pb2_grpc.py 2>/dev/null || true

# Expose port (50051 gRPC)
EXPOSE 50051

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import grpc" || exit 1

# Run gRPC server
CMD ["python", "-m", "elap_ai.grpc_server"]
